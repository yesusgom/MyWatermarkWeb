{
  "name": "Marca de Agua",
  "short_name": "Marca Agua",
  "description": "Añade una marca de agua a tus fotos desde el móvil, la tableta o el ordenador. Todo local, sin servidor.",
  "lang": "es",
  "dir": "ltr",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0e1117",
  "theme_color": "#0e1117",
  "categories": ["photo", "graphics", "utilities"],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
